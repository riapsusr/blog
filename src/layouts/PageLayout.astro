---
import { ClientRouter } from "astro:transitions"; 
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
    
    <!-- 引入 霞鹜文楷：使用 elemecdn 镜像，这是国内目前最稳定的源 -->
    <link rel="stylesheet" href="https://npm.elemecdn.com/lxgw-wenkai-screen-webfont@1.1.0/style.css" />
    
    <ClientRouter fallback="swap" />
  </head>
  <body class="bg-stone-100 dark:bg-stone-900 transition-colors duration-300">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>