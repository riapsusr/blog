---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<PageLayout title="404" description="Page not found">
  <Container>
    <div class="flex flex-col items-center justify-center min-h-[calc(100vh-300px)] space-y-6">
      <h1 class="text-6xl font-bold text-fg dark:text-fg-invert">404</h1>
      <p class="text-lg text-muted">
        你似乎来到了不存在的荒原
      </p>
      <div class="pt-6">
        <Link href="/">返回首页</Link>
      </div>
    </div>
  </Container>
</PageLayout>
