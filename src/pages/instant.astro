---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

// 获取并按时间倒序排序
// 优化点：既然是 z.coerce.date()，它已经是 Date 对象，直接用 getTime() 比较更可靠
const data = (await getCollection("instant")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// 定义一个格式化函数
const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

// 将数据按年份分组
const instantsByYear = data.reduce((acc, item) => {
  const year = item.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(item);
  return acc;
}, {} as Record<string, any[]>); // 加上类型定义防止报错

const years = Object.keys(instantsByYear).sort((a, b) => parseInt(b) - parseInt(a));

const INSTANT = {
  TITLE: "Instant",
  DESCRIPTION: "Captured moments, fleeting memories."
};
---

<PageLayout title={INSTANT.TITLE} description={INSTANT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Instant
      </div>

      <div class="space-y-12">
        {years.map(year => (
          <section class="animate space-y-8">
            <div class="font-semibold text-black dark:text-white pt-4">
              {year}
            </div>

            <div class="space-y-16">
              {instantsByYear[year].map(async (item) => {
                const { Content } = await item.render();
                return (
                  <article class="space-y-4">
                    {/* 图片展示区保持不变... */}
                    <div class={`grid gap-2 ${
                      item.data.images.length === 1 ? 'grid-cols-1' : 
                      item.data.images.length === 2 ? 'grid-cols-2' : 'grid-cols-3'
                    }`}>
                      {item.data.images.map((img: string) => (
                        <img 
                          src={img} 
                          alt={item.data.location}
                          loading="lazy" 
                          decoding="async"
                          class="rounded-sm w-full aspect-[4/3] object-cover cursor-zoom-in hover:opacity-95 transition-opacity photo-zoom"
                        />
                      ))}
                    </div>

                    {/* 修改日期显示部分 */}
                    <div class="text-[13px] text-zinc-400 dark:text-zinc-500 flex items-center gap-2">
                      <time datetime={item.data.date.toISOString()}>
                        {formatDate(item.data.date)}
                      </time>
                      <span>·</span>
                      <span>{item.data.location}</span>
                    </div>

                    {/* 描述和分割线保持不变... */}
                    <div class="description text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed text-justify">
                      <Content />
                    </div>
                    <div class="pt-8 border-b border-black/5 dark:border-white/5"></div>
                  </article>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>

<style is:global>
  .description {
    text-align: justify;
    text-justify: inter-character;
  }
  .description p {
    margin: 0;
  }
  
  /* 当图片被 medium-zoom 打开时（它会自动添加这个类名） */
  .medium-zoom-image--opened {
    /* 1. 强制取消裁剪方式，改为包含全图 */
    object-fit: contain !important; 
    /* 2. 取消之前设置的 4:3 比例限制，恢复原始比例 */
    aspect-ratio: auto !important; 
    /* 3. 确保放大后层级最高 */
    z-index: 100;
  }

  /* 放大时的背景层级，确保在图片下方 */
  .medium-zoom-overlay {
    z-index: 99;
    background: rgba(255, 255, 255, 0.98) !important;
  }
</style>

<script>
  import mediumZoom from 'medium-zoom';
  const initZoom = () => {
    mediumZoom('.photo-zoom', {
      background: 'rgba(255, 255, 255, 0.98)',
      margin: 20
    });
  };
  initZoom();
  document.addEventListener('astro:after-swap', initZoom);
</script>