---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { INSTANT } from "@consts";

const data = (await getCollection("instant")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const instantsByYear = data.reduce((acc, item) => {
  const year = item.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(item);
  return acc;
}, {} as Record<string, any[]>);

const years = Object.keys(instantsByYear).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={INSTANT.TITLE} description={INSTANT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white px-3">
        Instant
      </div>

      <div class="space-y-12">
        {years.map(year => (
          <section class="animate space-y-4">
            <div class="font-semibold text-black dark:text-white pt-10 px-3">
              {year}
            </div>

            <div class="space-y-16">
              {instantsByYear[year].map(async (item) => {
                const { Content } = await item.render();
                const firstImage = item.data.images[0];
                
                return (
                  <article class="space-y-4 px-3">
                    {firstImage && (
                      <div class="instant-image-wrapper">
                        <Image 
                          src={firstImage} 
                          alt={item.data.location || "Moment"}
                          width={1200} 
                          quality={80}
                          format="webp"
                          loading="lazy" 
                          decoding="async"
                          class="w-full h-auto object-cover"
                        />
                      </div>
                    )}

                    <div class="text-[13px] text-zinc-400 dark:text-zinc-500 flex items-center gap-2">
                      <time datetime={item.data.date.toISOString()}>
                        {formatDate(item.data.date)}
                      </time>
                      <span>·</span>
                      <span>{item.data.location}</span>
                    </div>

                    <div class="description text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed text-justify">
                      <Content />
                    </div>
                    <div class="pt-8 border-b border-black/5 dark:border-white/5"></div>
                  </article>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>

<style is:global>
  .description {
    text-align: justify;
    text-justify: inter-character;
  }
  .description p {
    margin: 0;
  }
</style>