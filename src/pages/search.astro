---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

---

<PageLayout title="搜索" description="站内文章搜索">
  <slot name="head" slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </slot>
  <Container>
    <div class="space-y-10 min-h-[50vh]">
      <h1 class="font-semibold text-fg dark:text-fg-invert text-xl">搜索</h1>
      <div id="search"></div>
    </div>
  </Container>
</PageLayout>

<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script is:inline>
  function initPagefind() {
    const searchDiv = document.getElementById("search");
    if (!searchDiv) return;

    const PagefindUI = window.PagefindUI;
    if (typeof PagefindUI === "undefined") {
      const warning = document.createElement("div");
      warning.className = "text-center text-muted py-10";
      warning.innerHTML = "搜索功能仅在生产构建(Build)后可用<br>Dev 模式下无法预览搜索结果";
      searchDiv.innerHTML = "";
      searchDiv.appendChild(warning);
      return;
    }

    // 1.5 统一 guard 模式
    if (window.__cleanupPagefind__) {
      try { window.__cleanupPagefind__(); } catch { /* ignore */ }
    }

    searchDiv.innerHTML = ""; // 清空旧内容，确保重新初始化
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: "搜索文章...",
        clear_search: "清除",
        load_more: "加载更多结果",
        search_label: "站内搜索",
        filters_label: "筛选",
        zero_results: "未找到 [SEARCH_TERM] 的相关结果",
        many_results: "找到 [COUNT] 个关于 [SEARCH_TERM] 的结果",
        one_result: "找到 [COUNT] 个关于 [SEARCH_TERM] 的结果",
        alt_search: "未找到 [SEARCH_TERM] 的结果。改为显示 [DIFFERENT_TERM] 的结果",
        search_suggestion: "未找到 [SEARCH_TERM] 的结果。请尝试以下搜索词：",
        searching: "正在搜索 [SEARCH_TERM]..."
      }
    });

    window.__cleanupPagefind__ = function () { /* PagefindUI 无对外 dispose，仅置空 */ };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPagefind, { once: true });
  } else {
    initPagefind();
  }
</script>

<style is:global>
  /* Pagefind UI Customization */

  /* 确保根元素宽度 */
  #search .pagefind-ui {
    @apply w-full flex flex-col gap-4 !important;
  }

  /* 搜索表单容器 */
  #search .pagefind-ui__form {
    @apply relative flex flex-wrap items-center w-full !important;
  }

  /* 搜索框 */
  #search .pagefind-ui__search-input {
    @apply bg-transparent border-stone-200 dark:border-stone-700 text-fg dark:text-fg-invert rounded-md !important;
    @apply pl-12 pr-12 py-3 text-base !important;
    @apply transition-colors duration-200 !important;
    @apply w-full !important;
    @apply flex-1 !important;
    @apply min-w-0 !important;
    @apply max-w-full !important;
    @apply font-normal !important;
    @apply box-border !important;
    @apply block !important;
  }

  #search .pagefind-ui__search-input:focus {
    @apply border-fg dark:border-fg-invert outline-none !important;
  }

  /* 放大镜图标 */
  #search .pagefind-ui__form::before {
    @apply absolute left-4 w-5 h-5 opacity-60 z-10 !important;
    top: 25px !important;
    @apply -translate-y-1/2 !important;
    @apply bg-fg dark:bg-fg-invert !important;
    content: "" !important;
    @apply pointer-events-none !important;
  }

  /* 清除按钮 */
  #search .pagefind-ui__search-clear {
    @apply bg-transparent text-muted !important;
    @apply px-3 py-1 !important;
    @apply cursor-pointer transition-colors duration-200 !important;
    @apply absolute right-2 !important;
    top: 25px !important;
    @apply -translate-y-1/2 !important;
    @apply text-sm !important;
    @apply border-none rounded-none !important;
    @apply w-auto h-auto !important;
    @apply m-0 !important;
    @apply whitespace-nowrap !important;
    @apply z-20 !important;
  }

  #search .pagefind-ui__search-clear:hover {
    @apply text-fg dark:text-fg-invert !important;
    @apply bg-transparent !important;
  }

  /* 搜索结果区域 */
  #search .pagefind-ui__drawer {
    @apply gap-8 !important;
    @apply mt-8 !important;
    @apply w-full !important;
    @apply static !important;
    @apply block !important;
    @apply flex-none !important;
  }

  /* 单个结果项 */
  .pagefind-ui__result {
    @apply border-b border-black/5 dark:border-white/5 py-6 !important;
    @apply flex flex-col gap-2 !important;
  }

  .pagefind-ui__result:last-child {
    @apply border-none !important;
  }

  /* 结果标题 */
  .pagefind-ui__result-title {
    @apply text-lg font-medium text-fg dark:text-fg-invert !important;
    @apply no-underline !important;
  }

  .pagefind-ui__result-link {
    @apply text-fg dark:text-fg-invert no-underline hover:underline underline-offset-4 decoration-black/20 dark:decoration-white/30 transition-all !important;
  }

  /* 结果摘要 */
  .pagefind-ui__result-excerpt {
    @apply text-sm text-muted !important;
    @apply leading-relaxed !important;
    @apply font-normal !important;
  }

  /* 高亮文本 */
  .pagefind-ui__result-excerpt mark {
    @apply bg-yellow-200 dark:bg-yellow-500/30 text-fg dark:text-fg-invert rounded-none px-0.5 !important;
    @apply font-medium !important;
  }

  /* 提示信息 */
  .pagefind-ui__message {
    @apply text-muted !important;
    @apply text-sm mt-4 !important;
    @apply font-normal !important;
  }

  /* 加载更多按钮 */
  .pagefind-ui__button {
    @apply bg-transparent text-muted !important;
    @apply border border-stone-200 dark:border-stone-700 rounded-sm !important;
    @apply py-2 px-6 mt-8 !important;
    @apply hover:text-fg dark:hover:text-fg-invert hover:border-fg dark:hover:border-fg-invert !important;
    @apply transition-colors duration-200 !important;
    @apply text-sm !important;
  }
</style>
