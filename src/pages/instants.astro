---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { INSTANTS } from "@consts";

const data = (await getCollection("instants")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const formatDate = (date: Date) => date.toISOString().split('T')[0];

const instantsByYear = data.reduce((acc, item) => {
  const year = item.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {} as Record<string, any[]>);
const years = Object.keys(instantsByYear).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={INSTANTS.TITLE} description={INSTANTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="font-semibold text-black dark:text-white">刹那</div>
      <div class="space-y-12">
        {years.map(year => (
          <section class="space-y-4">
            <div class="font-semibold text-black dark:text-white pt-10">{year}</div>
            <div class="space-y-16">
              {instantsByYear[year].map(async (item) => {
                const { Content } = await item.render();
                return (
                  <article class="space-y-4">
                    {item.data.images[0] && (
                      <div class="instant-image-wrapper">
                        <Image src={item.data.images[0]} alt={item.data.location} width={1200} format="webp" class="w-full h-auto object-cover" />
                      </div>
                    )}
                    <div class="text-[13px] text-zinc-400 flex items-center gap-2">
                      <time>{formatDate(item.data.date)}</time><span>·</span><span>{item.data.location}</span>
                    </div>
                    <div class="description text-sm"><Content /></div>
                    <div class="pt-8 border-b border-black/5 dark:border-white/5"></div>
                  </article>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>