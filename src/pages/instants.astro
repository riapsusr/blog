---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import InstantCard from "@components/InstantCard.astro";
import { INSTANTS } from "@consts";

const data = (await getCollection("instants")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
// const formatDate = (date: Date) => date.toISOString().split('T')[0];

const instantsByYear = data.reduce((acc, item) => {
  const year = item.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {} as Record<string, any[]>);
const years = Object.keys(instantsByYear).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={INSTANTS.TITLE} description={INSTANTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="flex flex-col gap-4">
        {/* 修复1：使用 h1 且字号 text-xl，与 Posts 页标题保持一致 */}
        <h1 class="font-semibold text-black dark:text-white text-xl">刹那</h1>

        {/* 年份筛选按钮组 */}
        <div id="year-filter" class="flex flex-wrap gap-2 text-sm select-none">
          <a
            href="/instants"
            data-year="all"
            class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-500"
          >
            全部
          </a>

          {years.map((year) => (
            <a
              href={`/instants?year=${year}`}
              data-year={year}
              class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-500"
            >
              {year}
            </a>
          ))}
        </div>
      </div>

      {/* 修复2：容器使用 flex flex-col gap-12，与 Posts 页保持一致（原为 space-y-12） */}
      <div class="flex flex-col gap-12">
        {years.map(year => (
          <section class="year-section space-y-4" data-year={year}>
            {/* 修复3：将 pt-10 改为 pt-2，并添加 text-lg。这是导致间距过大的主要原因 */}
            <div class="font-semibold text-black dark:text-white pt-2 text-lg">{year}</div>
            <div class="space-y-16">
              {instantsByYear[year].map((item, index) => (
                <div class="instant-item">
                  <InstantCard entry={item} />
                  {index !== instantsByYear[year].length - 1 && (
                    <div class="pt-8 border-b border-black/5 dark:border-white/5"></div>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div id="empty-state" class="hidden text-stone-500 py-10 text-center">
        暂无内容
      </div>
    </div>
  </Container>
</PageLayout>

<script>
  function filterInstants() {
      // 安全检查
      const filterContainer = document.getElementById('year-filter');
      if (!filterContainer) return;

      const params = new URLSearchParams(window.location.search);
      const currentYear = params.get("year");
      
      // 1. 处理按钮样式
      const buttons = filterContainer.querySelectorAll('.filter-btn');
      
      buttons.forEach(btn => {
          const btnYear = btn.getAttribute('data-year');
          const isActive = (!currentYear && btnYear === 'all') || (currentYear === btnYear);

          if (isActive) {
              btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
              btn.classList.remove('text-stone-500', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
          } else {
              btn.classList.remove('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
              btn.classList.add('text-stone-500', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
          }
      });

      // 2. 筛选年份区块
      const sections = document.querySelectorAll('.year-section');
      let hasVisibleSections = false;

      sections.forEach(section => {
          const sectionYear = section.getAttribute('data-year');
          if (!currentYear || sectionYear === currentYear) {
              section.classList.remove('hidden');
              hasVisibleSections = true;
          } else {
              section.classList.add('hidden');
          }
      });

      // 3. 处理空状态
      const emptyState = document.getElementById('empty-state');
      if (!hasVisibleSections) {
          emptyState?.classList.remove('hidden');
      } else {
          emptyState?.classList.add('hidden');
      }
  }

  // 初始化运行
  filterInstants();

  // View Transitions 切换后重新运行
  document.addEventListener('astro:after-swap', filterInstants);
</script>