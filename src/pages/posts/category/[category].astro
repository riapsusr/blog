---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostArchive from "@components/PostArchive.astro";
import { getPublishedPosts } from "@lib/utils";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];

  // posts 通过 props 传入，避免页面 frontmatter 再次拉取/排序。
  return categories.map((category) => ({ params: { category }, props: { posts } }));
}

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const category = Astro.params.category!;
---

<PageLayout title={`文章：${category}`} description={`分类「${category}」下的所有文章`}>
  <Container>
    <PostArchive posts={posts} activeCategory={category} />
  </Container>
</PageLayout>
