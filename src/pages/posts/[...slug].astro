---
import { type CollectionEntry, render } from "astro:content";
import { getPostCategoryURL, getPublishedPosts, getPostSlug, getPostExcerpt } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import TableOfContents from "@components/TableOfContents.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post.id) },
    props: post,
  }));
}
type Props = CollectionEntry<"posts">;
const post = Astro.props;
const { Content, headings } = await render(post);
// 1.1 SEO description：用真实摘要，而非标题占位
const description = getPostExcerpt(post.body, 160);
---

<PageLayout title={post.data.title} description={description} publishedTime={post.data.date}>
  <Container>
    <div class="relative">
      <div class="space-y-4 mt-8 mb-12">
        <h1 class="text-2xl font-semibold text-fg dark:text-fg-invert leading-tight">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-2 text-sm text-muted">
          <FormattedDate date={post.data.date} />
          <span aria-hidden="true">&bull;</span>
          <a 
              href={getPostCategoryURL(post.data.category)}
              class="hover:text-fg dark:hover:text-fg-invert underline underline-offset-2 transition-colors"
          >
              {post.data.category}
          </a>
        </div>
      </div>
      <article data-pagefind-body>
        <span class="sr-only" data-pagefind-filter="category">{post.data.category}</span>
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>
  </Container>
</PageLayout>
