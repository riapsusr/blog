---
import { type CollectionEntry } from "astro:content";
import { getPublishedPosts } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { POSTS } from "@consts";

const allPosts = await getPublishedPosts();

// 2. 动态生成分类列表并按频次排序
const categoryCounts = allPosts.reduce((acc, post) => {
    const cat = post.data.category;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
}, {} as Record<string, number>);

const categories = Object.keys(categoryCounts).sort(
    (a, b) => categoryCounts[b] - categoryCounts[a]
);

// 3. 按年份分组
type Acc = { [year: string]: CollectionEntry<"posts">[] };
const postsByYear = allPosts.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort(
  (a, b) => parseInt(b) - parseInt(a),
);
---

<PageLayout title={POSTS.TITLE} description={POSTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="flex flex-col gap-4">
        <h1 class="font-semibold text-black dark:text-white text-xl">文章</h1>
        
        {/* 分类筛选按钮组 - 关键ID: category-filter */}
        <div id="category-filter" class="flex flex-wrap gap-2 text-sm select-none">
            {/* "全部" 按钮 */}
            <a
                href="/posts"
                data-cat="all"
                class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-500"
            >
                全部
            </a>

            {/* 各个分类按钮 */}
            {categories.map((category) => (
                <a
                    href={`/posts?category=${encodeURIComponent(category)}`}
                    data-cat={category}
                    class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-500"
                >
                    {category}
                </a>
            ))}
        </div>
      </div>

      <div class="flex flex-col gap-12">
        {
            years.map((year) => (
              <section class="year-section space-y-4">
                <div class="font-semibold text-black dark:text-white pt-2 text-lg">
                  {year}
                </div>
                <ul class="flex flex-col gap-0">
                  {postsByYear[year].map((post, index) => (
                    <li class="post-item" data-category={post.data.category}>
                      <ArrowCard 
                        entry={post} 
                        class:list={[
                          index === 0 && "rounded-t-lg",
                          index === postsByYear[year].length - 1 && "rounded-b-lg border-b-0"
                        ]}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            ))
        }
      </div>
      
      {/* 空状态提示 */}
      <div id="empty-state" class="hidden text-stone-500 py-10 text-center">
        该分类下暂无文章
      </div>

    </div>
  </Container>
</PageLayout>

<script>
    function filterPosts() {
        // [关键修复] 安全检查：
        // 只有当页面存在 id="category-filter" 时才执行逻辑
        // 如果当前页面不存在这个筛选容器，这里会获取到 null，函数直接返回，避免污染其他页面的 DOM
        const filterContainer = document.getElementById('category-filter');
        if (!filterContainer) return;

        const params = new URLSearchParams(window.location.search);
        const currentCategory = params.get("category");
        
        // 1. 处理按钮样式 (限定在 filterContainer 内查找，更安全)
        const buttons = filterContainer.querySelectorAll('.filter-btn');
        
        buttons.forEach(btn => {
            const btnCat = btn.getAttribute('data-cat');
            // 判断逻辑：如果 URL 没参数且按钮是 all，或者参数与按钮匹配
            const isActive = (!currentCategory && btnCat === 'all') || (currentCategory === btnCat);

            if (isActive) {
                // 激活样式
                btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
                btn.classList.remove('text-stone-500', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
            } else {
                // 未激活样式（重置）
                btn.classList.remove('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
                btn.classList.add('text-stone-500', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
            }
        });

        // 2. 筛选文章
        const posts = document.querySelectorAll('.post-item');
        let hasVisiblePosts = false;

        posts.forEach(post => {
            const postCat = post.getAttribute('data-category');
            if (!currentCategory || postCat === currentCategory) {
                post.classList.remove('hidden');
                hasVisiblePosts = true;
            } else {
                post.classList.add('hidden');
            }
        });

        // 3. 处理年份标题
        const yearSections = document.querySelectorAll('.year-section');
        yearSections.forEach(section => {
            const visiblePostsInYear = section.querySelectorAll('.post-item:not(.hidden)');
            if (visiblePostsInYear.length > 0) {
                section.classList.remove('hidden');
                
                // 3.1 动态更新圆角样式
                const visibleLinks = section.querySelectorAll('.post-item:not(.hidden) > a');
                visibleLinks.forEach((link, index) => {
                    const isFirst = index === 0;
                    const isLast = index === visibleLinks.length - 1;
                    
                    // 重置样式
                    link.classList.remove('rounded-t-lg', 'rounded-b-lg', 'border-b-0');
                    
                    if (isFirst) {
                        link.classList.add('rounded-t-lg');
                    }
                    if (isLast) {
                        link.classList.add('rounded-b-lg', 'border-b-0');
                    }
                });

            } else {
                section.classList.add('hidden');
            }
        });

        // 4. 处理空状态提示
        const emptyState = document.getElementById('empty-state');
        if (!hasVisiblePosts) {
            emptyState?.classList.remove('hidden');
        } else {
            emptyState?.classList.add('hidden');
        }
    }

    // 初始化运行
    filterPosts();
</script>
