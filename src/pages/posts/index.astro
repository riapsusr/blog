---
import { type CollectionEntry } from "astro:content";
import { getPublishedPosts } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { POSTS } from "@consts";

const allPosts = await getPublishedPosts();

// 2. 动态生成分类列表并按频次排序
const categoryCounts = allPosts.reduce((acc, post) => {
    const cat = post.data.category;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
}, {} as Record<string, number>);

const categories = Object.keys(categoryCounts).sort(
    (a, b) => categoryCounts[b] - categoryCounts[a]
);

// 3. 按年份分组
type Acc = { [year: string]: CollectionEntry<"posts">[] };
const postsByYear = allPosts.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort(
  (a, b) => parseInt(b) - parseInt(a),
);
---

<PageLayout title={POSTS.TITLE} description={POSTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="flex flex-col gap-4">
        <h1 class="font-semibold text-fg dark:text-fg-invert text-xl">文章</h1>
        
        {/* 分类筛选按钮组 - 关键ID: category-filter */}
        <div id="category-filter" class="flex flex-wrap gap-2 text-sm select-none">
            {/* "全部" 按钮 */}
            <a
                href="/posts"
                data-cat="all"
                class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-muted"
            >
                全部
            </a>

            {/* 各个分类按钮 */}
            {categories.map((category) => (
                <a
                    href={`/posts?category=${encodeURIComponent(category)}`}
                    data-cat={category}
                    class="filter-btn px-3 py-1 rounded-full transition-colors duration-200 border border-transparent hover:bg-stone-100 dark:hover:bg-stone-800 text-muted"
                >
                    {category}
                </a>
            ))}
        </div>
      </div>

      <div class="flex flex-col gap-12">
        {
            years.map((year) => (
              <section class="year-section space-y-4">
                <div class="font-semibold text-fg dark:text-fg-invert pt-2 text-lg">
                  {year}
                </div>
                <ul class="flex flex-col gap-0">
                  {postsByYear[year].map((post, index, arr) => (
                    <li class="post-item" data-category={post.data.category}>
                      <ArrowCard 
                        entry={post} 
                        class:list={[
                          index === 0 && "rounded-t-lg",
                          index === arr.length - 1 && "rounded-b-lg border-b-0"
                        ]}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            ))
        }
      </div>
      
      {/* 空状态提示 */}
      <div id="empty-state" class="hidden text-muted py-10 text-center">
        该分类下暂无文章
      </div>

    </div>
  </Container>
</PageLayout>

<script is:inline>
  (function () {
    // 1.5 统一 guard 模式
    if (window.__cleanupPostFilter__) {
      try { window.__cleanupPostFilter__(); } catch { /* ignore */ }
    }

    function filterPosts() {
        // 安全检查：仅在该页存在筛选容器时执行
        const filterContainer = document.getElementById('category-filter');
        if (!filterContainer) return;

        const params = new URLSearchParams(window.location.search);
        const currentCategory = params.get("category");
        
        const buttons = filterContainer.querySelectorAll('.filter-btn');
        
        buttons.forEach(function(btn) {
            const btnCat = btn.getAttribute('data-cat');
            const isActive = (!currentCategory && btnCat === 'all') || (currentCategory === btnCat);

            if (isActive) {
                btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
                btn.classList.remove('text-muted', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
            } else {
                btn.classList.remove('bg-stone-800', 'text-white', 'border-stone-800', 'dark:bg-white', 'dark:text-black', 'dark:border-white');
                btn.classList.add('text-muted', 'border-transparent', 'hover:bg-stone-100', 'dark:hover:bg-stone-800');
            }
        });

        const posts = document.querySelectorAll('.post-item');
        let hasVisiblePosts = false;

        posts.forEach(function(post) {
            const postCat = post.getAttribute('data-category');
            if (!currentCategory || postCat === currentCategory) {
                post.classList.remove('hidden');
                hasVisiblePosts = true;
            } else {
                post.classList.add('hidden');
            }
        });

        const yearSections = document.querySelectorAll('.year-section');
        yearSections.forEach(function(section) {
            const visiblePostsInYear = section.querySelectorAll('.post-item:not(.hidden)');
            if (visiblePostsInYear.length > 0) {
                section.classList.remove('hidden');
                
                const visibleLinks = section.querySelectorAll('.post-item:not(.hidden) > a');
                visibleLinks.forEach(function(link, index) {
                    const isFirst = index === 0;
                    const isLast = index === visibleLinks.length - 1;
                    
                    link.classList.remove('rounded-t-lg', 'rounded-b-lg', 'border-b-0');
                    
                    if (isFirst) {
                        link.classList.add('rounded-t-lg');
                    }
                    if (isLast) {
                        link.classList.add('rounded-b-lg', 'border-b-0');
                    }
                });

            } else {
                section.classList.add('hidden');
            }
        });

        const emptyState = document.getElementById('empty-state');
        if (!hasVisiblePosts) {
            emptyState?.classList.remove('hidden');
        } else {
            emptyState?.classList.add('hidden');
        }
    }

    filterPosts();

    // 暴露一个无操作 cleanup 以对齐统一模式
    window.__cleanupPostFilter__ = function () { /* 该筛选为无状态单次运行；无需清理 */ };
  })();
</script>
