---
import Container from "@components/Container.astro";
import InteractiveDogLogo from "@components/InteractiveDogLogo.astro";
import Link from "@components/Link.astro";
import { SITE, NAV_ITEMS } from "@consts";

const { pathname } = Astro.url;

const activeClass = (path: string) => {
  let isActive: boolean;
  if (path === "/") {
    isActive = pathname === "/";
  } else {
    isActive = pathname === path
      || pathname.startsWith(path + "/")
      || pathname.startsWith(path + "?")
      || pathname.startsWith(path + "#");
  }
  return isActive
    ? "text-fg dark:text-fg-invert font-semibold"
    : "text-muted hover:text-fg dark:hover:text-fg-invert transition-colors";
};
---

<header class="py-5">
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false} aria-label={SITE.NAME}>
        <div class="flex items-center text-fg dark:text-fg-invert">
          <InteractiveDogLogo />
        </div>
      </Link>

      <nav class="flex gap-1 sm:gap-2 text-sm items-center" aria-label="主导航">
        {NAV_ITEMS.map((item) => (
          <Link href={item.path} underline={false}>
            <span class:list={["px-2 py-1.5 rounded-sm text-center block", activeClass(item.path)]}>
              {item.label}
            </span>
          </Link>
        ))}
      </nav>
    </div>
  </Container>
</header>
