---
import Container from "@components/Container.astro";
import InteractiveDogLogo from "@components/InteractiveDogLogo.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const { pathname } = Astro.url;

const activeClass = (path: string) =>
  (pathname === path || pathname.startsWith(path + "/") || pathname.startsWith(path + "?"))
    ? "text-black dark:text-white font-semibold"
    : "text-stone-500 dark:text-stone-400 hover:text-black dark:hover:text-white transition-colors";
---

<header class="py-5">
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false} aria-label={SITE.NAME}>
        <div class="flex items-center text-black dark:text-white">
          <InteractiveDogLogo />
        </div>
      </Link>

      <nav class="flex gap-1 sm:gap-2 text-sm items-center">
        <Link href="/" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-none text-center block", activeClass("/")]}>
            首页
          </span>
        </Link>
        
        <Link href="/posts" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-none text-center block", activeClass("/posts")]}>
            文章
          </span>
        </Link>

        <Link href="/about" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-none text-center block", activeClass("/about")]}>
            关于
          </span>
        </Link>
      </nav>
    </div>
  </Container>
</header>
