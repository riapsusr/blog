---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const { pathname } = Astro.url;
const subpath = pathname.split("/")[1]; 

const activeClass = (path: string) =>
  (pathname === path || subpath === path.replace("/", ""))
    ? "text-black dark:text-white font-semibold"
    : "text-zinc-500 dark:text-zinc-400 hover:bg-zinc-200/60 dark:hover:bg-zinc-700/40 hover:text-black dark:hover:text-white transition-colors";
---

<header class="py-5">
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <!-- 左侧 Logo / 站名 -->
      <Link href="/" underline={false}>
        <div class="font-semibold text-black dark:text-white">
          {SITE.NAME}
        </div>
      </Link>

      <!-- 右侧导航菜单 -->
      <nav class="flex gap-1 sm:gap-2 text-sm items-center">
        <Link href="/blog" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-md text-center block", activeClass("/blog")]}>
            blog
          </span>
        </Link>

        <Link href="/instant" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-md text-center block", activeClass("/instant")]}>
            instant
          </span>
        </Link>

        <!-- 黑白模式切换按钮 -->
        <button
          id="theme-toggle"
          class="p-2 rounded-md transition-colors duration-200 hover:bg-zinc-200/60 dark:hover:bg-zinc-700/40 text-zinc-500 dark:text-zinc-400"
          aria-label="Toggle theme"
        >
          <svg id="sun-icon" class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m4.93 19.07 1.41-1.41"></path><path d="m17.66 6.34 1.41-1.41"></path>
          </svg>
          <svg id="moon-icon" class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById("theme-toggle");
    
    themeToggle?.addEventListener("click", () => {
      // 1. 创建一个临时的 style 标签，强制禁用全页面的动画
      const css = document.createElement("style");
      css.textContent = `
        * {
          -webkit-transition: none !important;
          -moz-transition: none !important;
          -o-transition: none !important;
          -ms-transition: none !important;
          transition: none !important;
        }
      `;
      document.head.appendChild(css);

      // 2. 执行黑白模式切换
      const element = document.documentElement;
      element.classList.toggle("dark");
      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");

      // 3. 强制浏览器重绘后，移除这个临时样式
      // 这行代码虽然看起来没用，但它会强制浏览器立即应用刚才的类名改变，而不触发动画
      window.getComputedStyle(css).opacity;
      document.head.removeChild(css);
    });
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>