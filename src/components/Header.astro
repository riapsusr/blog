---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const { pathname } = Astro.url;
const subpath = pathname.split("/")[1]; 

const activeClass = (path: string) =>
  (pathname === path || subpath === path.replace("/", ""))
    ? "text-black dark:text-white font-semibold"
    : "text-stone-500 dark:text-stone-400 hover:text-black dark:hover:text-white transition-colors";
---

<header class="py-5">
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false}>
        <div class="font-semibold text-black dark:text-white">
          {SITE.NAME}
        </div>
      </Link>

      <nav class="flex gap-1 sm:gap-2 text-sm items-center">
        <Link href="/posts" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-none text-center block", activeClass("/posts")]}>
            文章
          </span>
        </Link>

        <Link href="/instants" underline={false}>
          <span class:list={["px-2 py-1.5 rounded-none text-center block", activeClass("/instants")]}>
            刹那
          </span>
        </Link>

        <button
          id="theme-toggle"
          class="p-2 rounded-none transition-colors duration-200 text-stone-500 dark:text-stone-400 hover:text-black dark:hover:text-white"
          aria-label="Toggle theme"
        >
          <svg id="sun-icon" class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m4.93 19.07 1.41-1.41"></path><path d="m17.66 6.34 1.41-1.41"></path>
          </svg>
          <svg id="moon-icon" class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById("theme-toggle");
    themeToggle?.addEventListener("click", () => {
      const css = document.createElement("style");
      css.textContent = `* { transition: none !important; }`;
      document.head.appendChild(css);
      const element = document.documentElement;
      const isDark = element.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      window.getComputedStyle(css).opacity;
      document.head.removeChild(css);
    });
  }
  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>