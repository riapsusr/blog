---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// 只保留 h2
const tocItems = headings.filter((h) => h.depth === 2);
---

{
  tocItems.length > 0 && (
    <>
      {/* 桌面端：右侧固定目录 */}
      <nav
        class="hidden xl:block sticky top-32 w-48 max-h-[calc(100vh-8rem)] overflow-y-auto scrollbar-hide border border-black/10 dark:border-white/10 rounded-lg p-4"
        aria-label="目录"
      >
        <div class="text-xs font-semibold text-stone-400 dark:text-stone-500 mb-3 uppercase tracking-wider">
          目录
        </div>
        <ul class="space-y-2 text-sm">
          {tocItems.map((item) => (
            <li
              class:list={[
                "toc-item transition-all duration-200",
                item.depth === 3 && "pl-3",
              ]}
              data-slug={item.slug}
            >
              <a
                href={`#${item.slug}`}
                class="toc-link block text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors duration-200 leading-relaxed"
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* 移动端：底部悬浮按钮 + 抽屉 */}
      <div class="xl:hidden toc-mobile-container">
        {/* 悬浮按钮 */}
        <button
          class="toc-mobile-btn fixed bottom-28 right-5 z-40 w-10 h-10 bg-stone-200 dark:bg-stone-800 rounded-sm shadow-lg flex items-center justify-center text-stone-600 dark:text-stone-300 hover:bg-stone-300 dark:hover:bg-stone-700 transition-colors duration-200"
          aria-label="打开目录"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="15" y2="12" />
            <line x1="3" y1="18" x2="18" y2="18" />
          </svg>
        </button>

        {/* 遮罩层 */}
        <div
          class="toc-overlay fixed inset-0 z-40 bg-black/30 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
        />

        {/* 抽屉 */}
        <nav
          class="toc-drawer fixed bottom-0 left-0 right-0 z-50 bg-stone-100 dark:bg-stone-900 rounded-t-sm shadow-2xl transform translate-y-full transition-transform duration-300 ease-out max-h-[60vh] overflow-hidden"
          aria-label="目录"
        >
          <div class="flex items-center justify-between px-5 py-4 border-b border-stone-200 dark:border-stone-800">
            <span class="text-sm font-semibold text-stone-600 dark:text-stone-300">
              目录
            </span>
            <button
              class="toc-close-btn w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors"
              aria-label="关闭目录"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <ul class="p-5 space-y-3 overflow-y-auto scrollbar-hide max-h-[calc(60vh-60px)]">
            {tocItems.map((item) => (
              <li
                class:list={[
                  "toc-item-mobile transition-all duration-200",
                  item.depth === 3 && "pl-4",
                ]}
                data-slug={item.slug}
              >
                <a
                  href={`#${item.slug}`}
                  class="toc-link-mobile block text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors duration-200 py-1"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </>
  )
}

<script is:inline>
(function() {
  'use strict';

  /** @type {IntersectionObserver | null} */
  let observer = null;
  /** @type {Array<() => void>} */
  const cleanupFns = [];
  /** @type {boolean} */
  let isInitialized = false;

  function cleanup() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }

    while (cleanupFns.length > 0) {
      const fn = cleanupFns.pop();
      try { fn(); } catch { /* ignore cleanup errors */ }
    }

    document.body.style.overflow = "";

    isInitialized = false;
  }

  function setupTOC() {
    if (isInitialized) {
      cleanup();
    }

    /** @type {NodeListOf<HTMLElement>} */
    const headings = document.querySelectorAll(
      "article h2[id], article h3[id]",
    );
    /** @type {NodeListOf<HTMLAnchorElement>} */
    const tocLinks = document.querySelectorAll(".toc-link");
    /** @type {NodeListOf<HTMLAnchorElement>} */
    const tocLinksMobile = document.querySelectorAll(".toc-link-mobile");

    if (headings.length === 0) {
      isInitialized = true;
      return;
    }

    const h2List = [...document.querySelectorAll("article h2[id]")];
    /** @type {Map<string, string>} */
    const h3ToH2Map = new Map();
    document.querySelectorAll("article h3[id]").forEach((h3) => {
      let parentH2 = null;
      for (let i = h2List.length - 1; i >= 0; i--) {
        if (h2List[i].compareDocumentPosition(h3) & Node.DOCUMENT_POSITION_FOLLOWING) {
          parentH2 = h2List[i];
          break;
        }
      }
      if (parentH2) {
        h3ToH2Map.set(h3.getAttribute("id"), parentH2.getAttribute("id"));
      }
    });

    /**
     * @param {string | null} activeId
     */
    function updateActiveLink(activeId) {
      const resolvedId = h3ToH2Map.get(activeId) || activeId;

      /** @param {NodeListOf<HTMLAnchorElement>} links */
      const updateLinks = (links) => {
        links.forEach((link) => {
          const href = link.getAttribute("href");
          const isActive = href === `#${resolvedId}`;

          if (isActive) {
            link.classList.remove("text-stone-400", "dark:text-stone-500");
            link.classList.add("text-black", "dark:text-white", "font-semibold");
          } else {
            link.classList.add("text-stone-400", "dark:text-stone-500");
            link.classList.remove("text-black", "dark:text-white", "font-semibold");
          }
        });
      };

      updateLinks(tocLinks);
      updateLinks(tocLinksMobile);
    }

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            updateActiveLink(id);
          }
        });
      },
      {
        rootMargin: "-80px 0px -70% 0px",
        threshold: 0,
      },
    );

    headings.forEach((heading) => observer.observe(heading));

    const mobileContainers = document.querySelectorAll(".toc-mobile-container");

    mobileContainers.forEach(container => {
      const mobileBtn = container.querySelector(".toc-mobile-btn");
      const drawer = container.querySelector(".toc-drawer");
      const overlay = container.querySelector(".toc-overlay");
      const closeBtn = container.querySelector(".toc-close-btn");
      const links = container.querySelectorAll(".toc-link-mobile");

      function openDrawer() {
        drawer?.classList.remove("translate-y-full");
        drawer?.classList.add("translate-y-0");
        overlay?.classList.remove("opacity-0", "pointer-events-none");
        overlay?.classList.add("opacity-100", "pointer-events-auto");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer?.classList.add("translate-y-full");
        drawer?.classList.remove("translate-y-0");
        overlay?.classList.add("opacity-0", "pointer-events-none");
        overlay?.classList.remove("opacity-100", "pointer-events-auto");
        document.body.style.overflow = "";
      }

      /** @param {MouseEvent} e */
      const openHandler = (e) => {
        e.stopPropagation();
        openDrawer();
      };

      const closeHandler = () => closeDrawer();

      /** @param {MouseEvent} e */
      const linkClickHandler = (e) => {
        const link = /** @type {HTMLAnchorElement} */ (e.currentTarget);
        e.preventDefault();
        closeDrawer();

        const href = link.getAttribute("href");
        const targetId = href ? href.substring(1) : null;
        const target = targetId ? document.getElementById(targetId) : null;

        if (target) {
          setTimeout(() => {
            target.scrollIntoView({
              behavior: "smooth",
              block: "start"
            });
            if (href) {
              history.replaceState(null, "", href);
            }
          }, 50);
        }
      };

      mobileBtn?.addEventListener("click", openHandler);
      closeBtn?.addEventListener("click", closeHandler);
      overlay?.addEventListener("click", closeHandler);

      links.forEach(link => {
        link.addEventListener("click", linkClickHandler);
      });

      cleanupFns.push(() => {
        mobileBtn?.removeEventListener("click", openHandler);
        closeBtn?.removeEventListener("click", closeHandler);
        overlay?.removeEventListener("click", closeHandler);
        links.forEach(link => {
          link.removeEventListener("click", linkClickHandler);
        });
      });
    });

    isInitialized = true;
  }

  setupTOC();

  document.addEventListener('astro:after-swap', () => {
    setupTOC();
  });
})();
</script>
