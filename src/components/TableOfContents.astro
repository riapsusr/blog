---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// 只保留 h2
const tocItems = headings.filter((h) => h.depth === 2);
---

{
  tocItems.length > 0 && (
    <>
      {/* 桌面端：右侧固定目录 */}
      <div class="hidden xl:block absolute left-full top-0 h-full ml-12">
        <nav
          class="sticky top-32 w-48 max-h-[calc(100vh-8rem)] overflow-y-auto scrollbar-hide border border-line rounded-lg p-4"
          aria-label="目录"
        >
          <div class="text-xs font-semibold text-muted mb-3 uppercase tracking-wider">
            目录
          </div>
          <ul class="space-y-2 text-sm">
            {tocItems.map((item) => (
              <li
                class="toc-item transition-all duration-200"
                data-slug={item.slug}
              >
                <a
                  href={`#${item.slug}`}
                  class="toc-link block text-muted hover:text-fg dark:hover:text-fg-invert transition-colors duration-200 leading-relaxed"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      {/* 移动端：底部悬浮按钮 + 抽屉 */}
      <div class="xl:hidden toc-mobile-container">
        {/* 悬浮按钮 */}
        <button
          type="button"
          class="toc-mobile-btn fixed bottom-28 right-5 z-40 w-10 h-10 bg-control rounded-sm shadow-lg flex items-center justify-center text-body hover:bg-control-hover transition-colors duration-200"
          aria-label="打开目录"
          aria-expanded="false"
          aria-controls="toc-drawer"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="15" y2="12" />
            <line x1="3" y1="18" x2="18" y2="18" />
          </svg>
        </button>

        {/* 遮罩层 */}
        <div
          class="toc-overlay fixed inset-0 z-40 bg-overlay backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
          data-toc-overlay
        />

        {/* 抽屉 */}
        <div
          id="toc-drawer"
          class="toc-drawer fixed bottom-0 left-0 right-0 z-50 bg-surface-raised rounded-t-sm shadow-2xl transform translate-y-full transition-transform duration-300 ease-out max-h-[60vh] overflow-hidden"
          role="dialog"
          aria-modal="true"
          aria-labelledby="toc-drawer-title"
          aria-hidden="true"
          inert
        >
          <div class="flex items-center justify-between px-5 py-4 border-b border-line">
            <span id="toc-drawer-title" class="text-sm font-semibold text-muted">
              目录
            </span>
            <button
              type="button"
              class="toc-close-btn w-8 h-8 flex items-center justify-center text-muted hover:text-fg dark:hover:text-fg-invert transition-colors"
              aria-label="关闭目录"
            >
              <svg
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <nav aria-label="目录">
            <ul class="p-5 space-y-3 overflow-y-auto scrollbar-hide max-h-[calc(60vh-60px)]">
              {tocItems.map((item) => (
                <li
                  class="toc-item-mobile transition-all duration-200"
                  data-slug={item.slug}
                >
                  <a
                    href={`#${item.slug}`}
                    class="toc-link-mobile block text-muted hover:text-fg dark:hover:text-fg-invert transition-colors duration-200 py-1"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </>
  )
}

<style is:global>
  /* active 高亮 —— 由脚本统一切换 data-active 属性，样式集中在此 */
  .toc-item[data-active] .toc-link,
  .toc-item-mobile[data-active] .toc-link-mobile {
    @apply text-fg dark:text-fg-invert font-semibold;
  }
</style>

<script is:inline>
(function() {
  'use strict';

  if (window.__tocCleanup__) {
    try { window.__tocCleanup__(); } catch { /* ignore */ }
    window.__tocCleanup__ = null;
  }

  /** @type {IntersectionObserver | null} */
  let observer = null;
  /** @type {Array<() => void>} */
  const cleanupFns = [];

  /** @type {string | null} 当前激活 h2 的 id */
  let activeId = null;

  function cleanup() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }

    while (cleanupFns.length > 0) {
      const fn = cleanupFns.pop();
      try { fn(); } catch { /* ignore cleanup errors */ }
    }

    document.body.style.overflow = "";
  }

  /**
   * @param {string | null} id
   */
  function setActive(id) {
    if (id === activeId) return;
    activeId = id;

    document.querySelectorAll('.toc-item, .toc-item-mobile').forEach((li) => {
      if (li instanceof HTMLElement) {
        if (li.dataset.slug === id) {
          li.setAttribute('data-active', '');
        } else {
          li.removeAttribute('data-active');
        }
      }
    });
  }

  function setupTOC() {

    /** @type {NodeListOf<HTMLElement>} */
    const headings = document.querySelectorAll("article h2[id]");
    /** @type {NodeListOf<HTMLAnchorElement>} */
    const tocLinks = document.querySelectorAll(".toc-link");

    if (headings.length === 0) {
      window.__tocCleanup__ = cleanup;
      return;
    }

    /** 滚动到指定标题并同步 URL hash @param {string} targetId @param {string | null} href */
    function scrollToHeading(targetId, href) {
      const target = document.getElementById(targetId);
      if (!target) return;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      if (href) history.replaceState(null, "", href);
      setActive(targetId);
    }

    /**
     * 平滑滚动点击处理，桌面端和移动端共用。
     * @param {MouseEvent} e
     * @param {HTMLAnchorElement} link
     * @param {(() => void) | null} [after]
     */
    function linkClickHandler(e, link, after) {
      const href = link.getAttribute("href");
      const targetId = href ? href.substring(1) : null;
      if (!targetId) return;
      e.preventDefault();
      if (typeof after === "function") after();
      scrollToHeading(targetId, href);
    }

    // 桌面端链接：平滑滚动 + URL 同步
    tocLinks.forEach((link) => {
      const handler = /** @param {MouseEvent} e */ (e) => linkClickHandler(e, link, null);
      link.addEventListener("click", handler);
      cleanupFns.push(() => link.removeEventListener("click", handler));
    });

    // —— 激活态追踪 ——
    // 单 threshold 在短段落或长 h2 之间会出现“没人在视口里”的情况，
    // 用滚动兜底：每次 scroll 找到顶部最后一个已划过的 h2 作为激活项。
    const headingList = Array.from(headings);

    function updateByScroll() {
      const offset = 100; // 与 header 高度相关的补偿
      let current = null;
      for (const h of headingList) {
        if (h.getBoundingClientRect().top - offset <= 0) {
          current = h.id;
        } else {
          break;
        }
      }
      // 文章还没滚到第一个标题前，先不激活
      setActive(current);
    }

    observer = new IntersectionObserver(
      (entries) => {
        // 仅保留当前正进入视口的标题，但完全依赖 IO 在快速滚动时可能滞后，
        // 因此刷新一次 scroll 计算作为权威源。
        updateByScroll();
        // 触发结束后让 IO 也参与（避免 scroll 漏掉刚 enter 的）
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      },
      {
        rootMargin: "-80px 0px -70% 0px",
        threshold: [0, 0.25, 0.5, 1],
      },
    );

    headings.forEach((heading) => observer.observe(heading));

    // scroll 作为 IO 兜底：节流到 rAF
    let scrollRaf = 0;
    const onScroll = () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = 0;
        updateByScroll();
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    cleanupFns.push(() => {
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      window.removeEventListener("scroll", onScroll);
    });

    // 初始化一次
    updateByScroll();

    // —— 移动端抽屉 ——
    const mobileContainer = document.querySelector(".toc-mobile-container");
    if (!mobileContainer) {
      window.__tocCleanup__ = cleanup;
      return;
    }

    const mobileBtn = mobileContainer.querySelector(".toc-mobile-btn");
    const drawer = mobileContainer.querySelector(".toc-drawer");
    const overlay = mobileContainer.querySelector("[data-toc-overlay]");
    const closeBtn = mobileContainer.querySelector(".toc-close-btn");
    const links = mobileContainer.querySelectorAll(".toc-link-mobile");

    /** 抽屉内可聚焦元素，用于焦点陷阱 @type {HTMLElement[]} */
    const focusables = Array.from(
      drawer
        ? drawer.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')
        : []
    ).filter((el) => el instanceof HTMLElement);

    function openDrawer() {
      drawer?.removeAttribute("inert");
      drawer?.setAttribute("aria-hidden", "false");
      drawer?.classList.remove("translate-y-full");
      drawer?.classList.add("translate-y-0");
      overlay?.classList.remove("opacity-0", "pointer-events-none");
      overlay?.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
      if (mobileBtn) mobileBtn.setAttribute("aria-expanded", "true");
      if (closeBtn instanceof HTMLElement) closeBtn.focus();
    }

    function closeDrawer({ restoreFocus = true } = {}) {
      drawer?.setAttribute("inert", "");
      drawer?.setAttribute("aria-hidden", "true");
      drawer?.classList.add("translate-y-full");
      drawer?.classList.remove("translate-y-0");
      overlay?.classList.add("opacity-0", "pointer-events-none");
      overlay?.classList.remove("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "";
      if (mobileBtn) mobileBtn.setAttribute("aria-expanded", "false");
      if (restoreFocus && mobileBtn instanceof HTMLElement) mobileBtn.focus();
    }

    /** @param {KeyboardEvent} e */
    function drawerKeyHandler(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeDrawer();
        return;
      }
      if (e.key === "Tab" && focusables.length > 0) {
        // 简单焦点陷阱：在第一个/最后一个之间循环
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    /** @param {MouseEvent} e */
    const openHandler = (e) => {
      e.stopPropagation();
      openDrawer();
    };

    const closeHandler = () => closeDrawer();

    /** @param {MouseEvent} e */
    const mobileLinkClickHandler = (e) => {
      const link = /** @type {HTMLAnchorElement} */ (e.currentTarget);
      linkClickHandler(e, link, closeDrawer);
    };

    mobileBtn?.addEventListener("click", openHandler);
    closeBtn?.addEventListener("click", closeHandler);
    overlay?.addEventListener("click", closeHandler);
    drawer?.addEventListener("keydown", drawerKeyHandler);

    links.forEach(link => {
      link.addEventListener("click", mobileLinkClickHandler);
    });

    cleanupFns.push(() => {
      closeDrawer({ restoreFocus: false });
      mobileBtn?.removeEventListener("click", openHandler);
      closeBtn?.removeEventListener("click", closeHandler);
      overlay?.removeEventListener("click", closeHandler);
      drawer?.removeEventListener("keydown", drawerKeyHandler);
      links.forEach(link => {
        link.removeEventListener("click", mobileLinkClickHandler);
      });
    });

    window.__tocCleanup__ = cleanup;
  }

  setupTOC();
})();
</script>
