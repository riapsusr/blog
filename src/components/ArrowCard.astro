---
import type { CollectionEntry } from "astro:content";
import { formatShortDate, getPostSlug, getPostExcerpt } from "@lib/utils";
type Props = { 
  entry: CollectionEntry<"posts">;
  class?: string;
}
const { entry, class: className } = Astro.props;
const formattedDate = formatShortDate(entry.data.date);
const href = `/${entry.collection}/${getPostSlug(entry.id)}`;
const excerpt = getPostExcerpt(entry.body);
---

<a 
  href={href}
  class:list={[
    "relative group flex flex-nowrap py-4 px-3 -mx-3 items-center gap-4 transition-all duration-300 border-b border-black/5 dark:border-white/5 hover:bg-black/[0.12] dark:hover:bg-white/[0.15] -mb-[1px] shadow-none",
    className
  ]}
>
  <!-- 移除所有 font-sans 确保字体继承 -->
  <div class="text-sm tabular-nums opacity-50 flex-shrink-0 font-mono">
    {formattedDate}
  </div>

  <div class="flex flex-col flex-1 truncate">
    <div class="font-medium text-stone-800 dark:text-stone-200 group-hover:text-black group-hover:dark:text-white transition-colors duration-300 text-base">
      {entry.data.title}
    </div>
    <div class="text-sm opacity-50 truncate mt-1">
      {excerpt}
    </div>
  </div>

  <div class="flex-shrink-0 ml-2">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4 stroke-2 fill-none stroke-current opacity-20 group-hover:opacity-100 transition-all duration-300">
      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300" />
      <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300" />
    </svg>
  </div>
</a>