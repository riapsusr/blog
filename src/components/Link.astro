---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  underline?: boolean;
}

const { href, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  class={cn("inline-block decoration-decoration hover:decoration-fg dark:hover:decoration-fg-invert text-current hover:text-fg dark:hover:text-fg-invert transition-colors duration-300 ease-in-out", underline && "underline underline-offset-2")}
  {...rest}>
  <slot/>
</a>
