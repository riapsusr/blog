<svg
  class="interactive-dog-logo h-12 w-12 shrink-0 overflow-visible"
  viewBox="0 0 180 180"
  aria-hidden="true"
  focusable="false"
  data-dog-logo
>
  <g data-dog-head>
    <path
      data-dog-left-ear
      d="M47 71C42 56 43 38 52 27C66 29 77 44 80 66Z"
      fill="#efb46d"
      stroke="#1f1715"
      stroke-width="5.5"
      stroke-linejoin="round"
    />
    <path
      data-dog-right-ear
      d="M133 71C138 56 137 38 128 27C114 29 103 44 100 66Z"
      fill="#efb46d"
      stroke="#1f1715"
      stroke-width="5.5"
      stroke-linejoin="round"
    />
    <path d="M56 59C53 48 54 39 58 34C66 39 72 50 74 61Z" fill="#fff1d6" />
    <path d="M124 59C127 48 126 39 122 34C114 39 108 50 106 61Z" fill="#fff1d6" />

    <path
      d="M36 80C36 60 56 50 90 50C124 50 144 60 144 80C144 108 122 128 90 128C58 128 36 108 36 80Z"
      fill="#efb46d"
    />
    <path
      d="M69 54C81 49 99 49 111 54M49 66C41 72 36 82 36 94C37 116 59 128 90 128C121 128 143 116 144 94C144 82 139 72 131 66"
      fill="none"
      stroke="#1f1715"
      stroke-width="5.5"
      stroke-linecap="round"
    />
    <path
      d="M51 94C58 83 74 83 90 97C106 83 122 83 129 94C126 117 109 128 90 128C71 128 54 117 51 94Z"
      fill="#fff1d6"
    />
    <ellipse data-dog-left-cheek cx="59" cy="98" rx="14" ry="9" fill="#f28b82" opacity="0.82" />
    <ellipse data-dog-right-cheek cx="121" cy="98" rx="14" ry="9" fill="#f28b82" opacity="0.82" />

    <path
      d="M56 121C72 133 108 133 124 121"
      fill="none"
      stroke="#1f1715"
      stroke-width="13"
      stroke-linecap="round"
    />
    <path
      data-dog-collar
      d="M56 121C72 133 108 133 124 121"
      fill="none"
      stroke="#c92f3f"
      stroke-width="8"
      stroke-linecap="round"
    />
    <circle data-dog-bell cx="90" cy="127" r="10.5" fill="#f4d34b" stroke="#1f1715" stroke-width="4.5" />
    <path d="M83.5 124H96.5" stroke="#1f1715" stroke-width="3.2" stroke-linecap="round" />
    <path d="M90 129V134.5" stroke="#1f1715" stroke-width="3.2" stroke-linecap="round" />
  </g>

  <g data-dog-face>
    <ellipse data-dog-left-eye cx="70" cy="78" rx="6.5" ry="7.5" fill="#1f1715" />
    <ellipse data-dog-right-eye cx="110" cy="78" rx="6.5" ry="7.5" fill="#1f1715" />
    <circle data-dog-left-eye-shine cx="72" cy="75" r="2" fill="#ffffff" />
    <circle data-dog-right-eye-shine cx="112" cy="75" r="2" fill="#ffffff" />
    <path
      data-dog-nose
      d="M82 90C82 84 87 81 90 81C93 81 98 84 98 90C98 95 94 98 90 98C86 98 82 95 82 90Z"
      fill="#1f1715"
    />
    <path
      data-dog-mouth
      d="M90 98C86 105 80 107 75 103M90 98C94 105 100 107 105 103"
      fill="none"
      stroke="#1f1715"
      stroke-width="4"
      stroke-linecap="round"
    />
  </g>
</svg>

<script>
  const initDogLogos = () => {
    const logos = document.querySelectorAll<SVGSVGElement>("[data-dog-logo]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    logos.forEach((logo) => {
      if (logo.dataset.ready === "true") return;
      logo.dataset.ready = "true";

      const query = (selector: string) => logo.querySelector(selector);
      const head = query("[data-dog-head]") as SVGGElement | null;
      const face = query("[data-dog-face]") as SVGGElement | null;
      const leftEar = query("[data-dog-left-ear]") as SVGPathElement | null;
      const rightEar = query("[data-dog-right-ear]") as SVGPathElement | null;
      const leftEye = query("[data-dog-left-eye]") as SVGEllipseElement | null;
      const rightEye = query("[data-dog-right-eye]") as SVGEllipseElement | null;
      const leftShine = query("[data-dog-left-eye-shine]") as SVGCircleElement | null;
      const rightShine = query("[data-dog-right-eye-shine]") as SVGCircleElement | null;
      const leftCheek = query("[data-dog-left-cheek]") as SVGEllipseElement | null;
      const rightCheek = query("[data-dog-right-cheek]") as SVGEllipseElement | null;

      const setEllipsePosition = (element: SVGEllipseElement | null, x: number, y: number) => {
        element?.setAttribute("cx", x.toFixed(2));
        element?.setAttribute("cy", y.toFixed(2));
      };

      const setCirclePosition = (element: SVGCircleElement | null, x: number, y: number) => {
        element?.setAttribute("cx", x.toFixed(2));
        element?.setAttribute("cy", y.toFixed(2));
      };

      const move = (clientX: number, clientY: number) => {
        const rect = logo.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const offsetX = clientX - centerX;
        const offsetY = clientY - centerY;
        const angle = Math.atan2(offsetY, offsetX);
        const distance = Math.min(Math.hypot(offsetX, offsetY) / 19, 4);
        const gazeDistance = Math.min(Math.hypot(offsetX, offsetY) / 16, 3.4);
        const headX = Math.cos(angle) * distance;
        const headY = Math.sin(angle) * distance;
        const gazeX = Math.cos(angle) * gazeDistance;
        const gazeY = Math.sin(angle) * gazeDistance;
        const earTilt = Math.max(Math.min(headX * 0.8, 3.5), -3.5);

        head?.setAttribute("transform", `translate(${(headX * 0.42).toFixed(2)} ${(headY * 0.32).toFixed(2)})`);
        face?.setAttribute("transform", `translate(${(headX * 0.68).toFixed(2)} ${(headY * 0.54).toFixed(2)})`);
        leftEar?.setAttribute("transform", `rotate(${(-earTilt).toFixed(2)} 61 51)`);
        rightEar?.setAttribute("transform", `rotate(${(-earTilt).toFixed(2)} 119 51)`);

        setEllipsePosition(leftEye, 70 + gazeX, 78 + gazeY);
        setEllipsePosition(rightEye, 110 + gazeX, 78 + gazeY);
        setCirclePosition(leftShine, 72 + gazeX, 75 + gazeY);
        setCirclePosition(rightShine, 112 + gazeX, 75 + gazeY);
        setEllipsePosition(leftCheek, 59 + headX * 0.34, 98 + headY * 0.24);
        setEllipsePosition(rightCheek, 121 + headX * 0.34, 98 + headY * 0.24);
      };

      if (prefersReducedMotion) return;

      let nextFrame = 0;
      const handlePointerMove = (event: PointerEvent) => {
        window.cancelAnimationFrame(nextFrame);
        nextFrame = window.requestAnimationFrame(() => move(event.clientX, event.clientY));
      };

      const blink = () => {
        leftEye?.setAttribute("ry", "1");
        rightEye?.setAttribute("ry", "1");
        leftShine?.setAttribute("opacity", "0");
        rightShine?.setAttribute("opacity", "0");

        window.setTimeout(() => {
          leftEye?.setAttribute("ry", "7.5");
          rightEye?.setAttribute("ry", "7.5");
          leftShine?.setAttribute("opacity", "1");
          rightShine?.setAttribute("opacity", "1");
        }, 150);

        window.setTimeout(blink, Math.random() * 3200 + 2200);
      };

      window.addEventListener("pointermove", handlePointerMove, { passive: true });
      window.setTimeout(blink, Math.random() * 1800 + 1200);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDogLogos, { once: true });
  } else {
    initDogLogos();
  }
</script>
