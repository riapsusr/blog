---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"instants">;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
const formatDate = (date: Date) => date.toISOString().split('T')[0];
---

<article class="space-y-4">
  {entry.data.images[0] && (
    <div class="instant-image-wrapper">
      <Image 
        src={entry.data.images[0]} 
        alt={entry.data.location} 
        width={1200} 
        format="webp" 
        class="w-full h-auto object-cover rounded-lg border border-black/5 dark:border-white/5" 
      />
    </div>
  )}
  <div class="text-[13px] text-zinc-400 flex items-center gap-2">
    <time>{formatDate(entry.data.date)}</time><span>·</span><span>{entry.data.location}</span>
  </div>
  <div class="description text-sm leading-relaxed"><Content /></div>
</article>